}

peripheral spi4 {
    base 0x40013400
    size 1024
    irq irq 84 
}

peripheral spi5 {
    base 0x40015000
    size 1024
    irq irq 85 
}

peripheral spi6 {
    base 0x58001400
    size 1024
    irq irq 86 
}

peripheral syscfg {
    base 0x58000400
    size 1024
}

peripheral exti {
    base 0x58000000
    size 1024
    irq exti0 6
    irq exti1 7
    irq exti2 8
    irq exti3 9
    irq exti4 10
    irq exti9_5 23
    irq exti15_10 40
}

peripheral usart1 {
    base 0x40011000
    size 1024
    irq irq 37 
}

peripheral usart2 {
    base 0x40004400
    size 1024
    irq irq 38 
}

peripheral usart3 {
    base 0x40004800
    size 1024
    irq irq 39 
}

peripheral uart4 {
    base 0x40004c00
    size 1024
    irq irq 52 
}

peripheral uart5 {
    base 0x40005000
    size 1024
    irq irq 53 
}

peripheral usart6 {
    base 0x40011400
    size 1024
    irq irq 71 
}

peripheral uart7 {
    base 0x40007800
    size 1024
    irq irq 82 
}

peripheral uart8 {
    base 0x40007c00
    size 1024

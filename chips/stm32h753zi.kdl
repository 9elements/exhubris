chip STM32H753ZI
target-triple thumbv7em-none-eabihf
probe-rs-name STM32H753ZI

compatible {
    - STM32H753ZI
    - STM32H753
    - STM32H7
    - arm-cortex-m7
}

vector-table-size 0x294

memory {
    region vectors {
        base 0x0800_0000
        size 0x2EC // needs to be 0x58(?) larger to accommodate header
        read
    }
    region flash {
        base 0x0800_02ec
        size 0x0ffd14 // 1024kiB - 0x2EC
        read
        execute
    }
    region ram {
        base 0x2000_0000
        size 0x20000 // 131072
        read
        write
    }
    region sram1_mac {
        // Network buffers are placed in sram1, which is directly accessible by the
        // Ethernet MAC.  We limit this use of sram1 to 64 KiB, and preserve the
        // remainder to be used for disjoint purposes (e.g., as an external region).
        base 0x30000000
        size 0x10000
        read
        write
        dma
    }
    region sram1 {
        base 0x30010000
        size 0x10000
        read
        write
        dma
    }
    region sram2 {
        base 0x30020000
        size 0x20000
        read
        write
        dma
    }
    region sram3 {
        base 0x30040000
        size 0x8000
        read
        write
        dma
    }
    region sram4 {
        base 0x38000000
        size 0x10000
        read
        write
        dma
    }
    region bank2 {
        base 0x08100000
        size 0x100000
        read
        write
        dma
    }
}

peripheral rcc {
    base 0x58024400
    size 1024
}

peripheral gpios {
    base 0x58020000
    size 0x4000
}

peripheral spi1 {
    base 0x40013000
    size 1024
